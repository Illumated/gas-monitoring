COMPOSE_PROJECT_NAME=gas-monitoring
TZ=Europe/Moscow

NODE_RED_PORT=1880
NODE_RED_CREDENTIAL_SECRET=replace-with-a-long-random-secret
NODE_RED_ADMIN_USER=admin
NODE_RED_ADMIN_PASSWORD_HASH=

MODBUS_HOST=192.168.50.10
MODBUS_PORT=502
MODBUS_UNIT_ID=65
MODBUS_POLL_INTERVAL_MS=5000
GAS_STALE_TIMEOUT_MS=20000
GAS_HYSTERESIS_BAR=0.1
GAS_DISPLAY_MAX_BAR=8

OXYGEN_WARN_LOW_BAR=3.5
OXYGEN_OK_LOW_BAR=4
OXYGEN_OK_HIGH_BAR=6
OXYGEN_WARN_HIGH_BAR=6.5
AIR_WARN_LOW_BAR=3.5
AIR_OK_LOW_BAR=4
AIR_OK_HIGH_BAR=6
AIR_WARN_HIGH_BAR=6.5
N2O_WARN_LOW_BAR=3.5
N2O_OK_LOW_BAR=4
N2O_OK_HIGH_BAR=6
N2O_WARN_HIGH_BAR=6.5

MAX_NOTIFICATIONS_ENABLED=false
MAX_API_URL=https://platform-api2.max.ru
MAX_BOT_TOKEN=
MAX_CHAT_ID=

INFLUXDB_PORT=8086
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=replace-with-a-long-random-password
INFLUXDB_ORG=rinir
INFLUXDB_BUCKET=wb
INFLUXDB_TOKEN=replace-with-a-long-random-token
