  {
    "id": "f60f006978a5c13d",
    "type": "function",
    "z": "8ec71f3bbce1da92",
    "name": "To ui-chart points",
    "func": "// node-red-contrib-influxdb возвращает массив строк (объектов)\n// Ожидаем поля: _time, _value\nconst rows = Array.isArray(msg.payload) ? msg.payload : [];\n\nconst points = rows\n  .filter(r => r && r._time !== undefined && r._value !== undefined)\n  .map(r => ({ x: new Date(r._time).getTime(), y: Number(r._value) }))\n  .filter(p => Number.isFinite(p.x) && Number.isFinite(p.y));\n\nmsg.payload = points;\nmsg.action = 'replace';\nreturn msg;\n",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1210,
    "y": 520,
    "wires": [
      [
        "3591815bd0613599"
      ]
    ]
  },
  {
    "id": "c4ee78f78988839e",
    "type": "function",
    "z": "8ec71f3bbce1da92",
    "name": "To Influx point",
    "func": "// На входе: msg.payload = число (bar), msg.topic = ch1|ch2|ch3\nconst v = Number(msg.payload);\nif (!Number.isFinite(v)) return null;\n\nconst ch = (msg.topic || 'ch1').toString();\n\n// Формат для node-red-contrib-influxdb:\n// [ fieldsObj, tagsObj ]\nmsg.payload = [\n  { pressure_bar: v, time: Date.now() },\n  { channel: ch }\n];\nreturn msg;\n",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 721.0001678466797,
