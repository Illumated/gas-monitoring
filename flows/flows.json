    "type": "function",
    "z": "flow-product",
    "name": "Development simulator",
    "func": "if (String(env.get(\"SIMULATION_MODE\")).toLowerCase() !== \"true\") return null;\nconst phase = (Date.now() / 60000) % (Math.PI * 2);\nconst values = {oxygen:50 + Math.sin(phase) * 4,air:52 + Math.sin(phase + 2) * 3,n2o:48 + Math.sin(phase + 4) * 5};\nreturn Object.entries(values).map(([topic, raw]) => ({topic,payload:{data:[Math.round(raw)]}}));",
