    "id": "0e7d5cc1956b074e",
    "type": "function",
    "z": "8ec71f3bbce1da92",
    "name": "Scale to bar",
    "func": "// берём первое слово из массива и делим на 100\n// при необходимости заменить на пересчёт из Па: value = value / 100000\nlet value = (msg.payload && Array.isArray(msg.payload.data)) ? msg.payload.data[0] : null;\nif (value === null || value === undefined) return null;\nvalue = value / 100; // предположение: устройство отдаёт *100 от бар\nmsg.payload = Number(value.toFixed(3));\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
