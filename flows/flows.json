  {
    "id": "87113a121893fd4c",
    "type": "function",
    "z": "8ec71f3bbce1da92",
    "name": "Build Flux query (180d, 1h mean)",
    "func": "// msg.payload = 'ch1' | 'ch2' | 'ch3'\nconst ch = (msg.payload || 'ch1').toString();\n\n// Параметры можно потом вынести в env/flow context\nconst bucket = 'rinir';\nconst measurement = 'wbmai6';\nconst field = 'pressure_bar';\nconst range = '-180d';\nconst every = '1h'; // агрегация для 180 дней (чтобы график был лёгким)\n\nmsg.topic = ch;\nmsg.query = `from(bucket: \"${bucket}\")\n  |> range(start: ${range}, stop: now())\n  |> filter(fn: (r) => r._measurement == \"${measurement}\")\n  |> filter(fn: (r) => r._field == \"${field}\")\n  |> filter(fn: (r) => r.channel == \"${ch}\")\n  |> aggregateWindow(every: ${every}, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"channel\"])\n  |> sort(columns: [\"_time\"])`;\nreturn msg;\n",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 710,
    "y": 520,
    "wires": [
      [
        "c64316af90fbefaa"
      ]
    ]
  },
