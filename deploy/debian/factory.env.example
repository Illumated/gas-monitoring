# Factory installation parameters. Copy to /etc/rinir-factory.env and edit there.

# Optional explicit Linux interface names. Leave empty to assign the first two
# physical Ethernet interfaces in lexicographic order: management, then Modbus.
MANAGEMENT_INTERFACE=
MODBUS_INTERFACE=

# Management LAN receives address, gateway and DNS from DHCP.
MANAGEMENT_DHCP=true

# Isolated TCP-RS485 LAN. No gateway and no DNS are configured on this interface.
MODBUS_ADDRESS=192.168.50.1/24
MODBUS_DEVICE_ADDRESS=192.168.50.10

# Salt is always installed and enabled. Empty SALT_MASTER keeps the default
# "salt" master name; inability to reach it never blocks gas-monitoring.
SALT_MASTER=

# Remote dashboard endpoint on the management LAN.
REMOTE_HTTPS_PORT=443
REMOTE_USER=operator

# Unique per-device credentials known to the commissioning engineer. The
# installer refuses the example placeholders. Use only A-Z, a-z, 0-9 and
# ._@+- characters so the file remains unambiguous shell syntax. Store it outside Git.
ADMIN_ACCESS_CODE=replace-with-unique-admin-code
NODE_RED_ADMIN_PASSWORD=replace-with-unique-editor-password
REMOTE_INITIAL_PASSWORD=replace-with-unique-remote-password

# Application defaults. Hospital and location are entered later in Service.
TZ=Europe/Moscow
INFLUXDB_RETENTION=8760h
