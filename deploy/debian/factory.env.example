# Параметры заводской установки. Скопируйте файл в /etc/rinir-factory.env и редактируйте копию.

# Необязательные явные имена Linux-интерфейсов. Оставьте пустыми, чтобы назначить
# первые два физических Ethernet-интерфейса по алфавиту: management, затем Modbus.
MANAGEMENT_INTERFACE=
MODBUS_INTERFACE=

# Management LAN получает адрес, gateway и DNS по DHCP.
MANAGEMENT_DHCP=true

# Изолированная TCP-RS485 LAN. Для этого интерфейса gateway и DNS не настраиваются.
MODBUS_ADDRESS=192.168.50.1/24
MODBUS_DEVICE_ADDRESS=192.168.50.10

# Salt всегда устанавливается и включается. Пустой SALT_MASTER сохраняет стандартное
# имя master "salt"; его недоступность никогда не блокирует gas-monitoring.
SALT_MASTER=

# Удалённый endpoint Dashboard в management LAN.
REMOTE_HTTPS_PORT=443
REMOTE_USER=operator

# Уникальные реквизиты устройства, известные инженеру пусконаладки. Installer
# отклоняет шаблонные значения. Используйте только A-Z, a-z, 0-9 и символы
# ._@+-, чтобы сохранить однозначный shell-синтаксис. Храните файл вне Git.
ADMIN_ACCESS_CODE=replace-with-unique-admin-code
NODE_RED_ADMIN_PASSWORD=replace-with-unique-editor-password
REMOTE_INITIAL_PASSWORD=replace-with-unique-remote-password

# Сервисный доступ Linux по SSH через management LAN. Имя пользователя фиксировано:
# "rinir"; пароль должен быть уникальным для устройства и храниться вне Git.
SSH_PASSWORD=replace-with-unique-ssh-password

# Настройки приложения по умолчанию. Больница и расположение вводятся позднее в разделе «Сервис».
TZ=Europe/Moscow
INFLUXDB_RETENTION=8760h
